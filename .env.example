# Copy to .env and adjust. All settings are optional.

# yahoo = live markets (Yahoo Finance, Stooq fallback) | fixture = synthetic demo data, no network
COCKPIT_PROVIDER=yahoo

# Free key from https://fred.stlouisfed.org/docs/api/api_key.html (without it the public CSV endpoint is used)
FRED_API_KEY=

# Storage and history
COCKPIT_DB=../data/cockpit.db
COCKPIT_HISTORY_DAYS=750

# Headlines + sentiment from public RSS feeds (1 = on)
COCKPIT_NEWS=1

# Trading rules
COCKPIT_MIN_PICK_SCORE=70
COCKPIT_JACKPOT_SCORE=80
COCKPIT_JACKPOT_MIN_EDGE=0.15
COCKPIT_REWARD_RISK=2.0
COCKPIT_MAX_HOLD_DAYS=15

# API
COCKPIT_CORS=*
COCKPIT_SCHEDULER=1
